# .env.local.example
# Copiez ce fichier en .env.local et complétez les valeurs

# Environnement
APP_ENV=dev
APP_DEBUG=1

# Mercure Configuration
MERCURE_URL=http://localhost:56427/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:56427/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"

# Database (PostgreSQL)
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

# Mailer (si nécessaire)
MAILER_DSN=null://null

# Messenger (file transport avec Doctrine)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
